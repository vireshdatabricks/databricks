CORS_ORIGINS=["http://localhost:3000"]
API_PREFIX=/api
LOG_LEVEL=INFO
BASE_PATH=/poc-name
# AI gateway (OpenAI-compatible) for snapshot-report draft generation.
# Field names match the intake-agent POC's .env so the same onboarded gateway
# credentials can be reused as-is. Leave AI_LIVE_ENABLED=false until access is approved.
AI_LIVE_ENABLED=false
AOAI_ENDPOINT=
AOAI_DEPLOYMENT=
AOAI_API_VERSION=
AZURE_OPENAI_API_KEY=
UHG_AUTH_URL=
UHG_SCOPE=
UHG_CLIENT_ID=
UHG_CLIENT_SECRET=
UHG_PROJECT_ID=
UHG_GATEWAY_ENDPOINT=
