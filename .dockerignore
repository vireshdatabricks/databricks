# Never include local credentials or virtual environments in any image build.
**/.env
**/.env.*
!**/.env.example
# frontend/.env is generated by CI at build time with non-secret runtime config.
!frontend/.env
**/.venv/
**/venv/
**/node_modules/

# Development and source-control artifacts.
.git/
.github/
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]
**/.DS_Store
**/.next/
